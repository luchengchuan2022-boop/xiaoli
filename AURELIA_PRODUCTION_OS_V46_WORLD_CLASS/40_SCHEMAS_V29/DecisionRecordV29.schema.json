{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"DecisionRecordV29",
  "type":"object",
  "required":["decision_id","scope","authority","hard_constraints","objectives","candidates","selected_candidate","tradeoffs","impact"],
  "properties":{
    "decision_id":{"type":"string"},"scope":{"type":"string"},"authority":{"type":"string"},
    "hard_constraints":{"type":"array","items":{"type":"string"}},
    "objectives":{"type":"array","items":{"type":"string"}},
    "candidates":{"type":"array","items":{"type":"object"}},
    "selected_candidate":{"type":"string"},
    "tradeoffs":{"type":"array","items":{"type":"string"}},
    "impact":{"type":"array","items":{"type":"string"}},
    "confidence":{"type":"number","minimum":0,"maximum":1}
  }
}
