{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"V22 Production Package",
  "type":"object",
  "required":["package_id","package_version","root_refs","artifacts","dependencies","evidence","validation","release_status"],
  "properties":{
    "package_id":{"type":"string"},
    "package_version":{"type":"string"},
    "root_refs":{"type":"array","items":{"type":"string"}},
    "artifacts":{"type":"array","items":{"type":"object"}},
    "dependencies":{"type":"array","items":{"type":"object"}},
    "evidence":{"type":"array","items":{"type":"object"}},
    "validation":{"type":"array","items":{"type":"object"}},
    "release_status":{"type":"string"}
  },
  "additionalProperties":true
}
