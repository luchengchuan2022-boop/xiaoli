{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v24/SemanticDelta",
  "type": "object",
  "required": [
    "before_ref",
    "after_ref",
    "delta_class",
    "changed_fields"
  ],
  "properties": {
    "before_ref": {
      "type": "string"
    },
    "after_ref": {
      "type": "string"
    },
    "delta_class": {
      "type": "string"
    },
    "changed_fields": {
      "type": "array"
    },
    "semantic_effect": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array"
    },
    "authorization_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
